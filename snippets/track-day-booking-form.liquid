{% comment %}
  Renders the track day event ticket booking form.
  Only renders when the current product's handle is 'track-day-event-ticket'.

  Every field is required. The product form is rendered with `novalidate` and
  submitted over AJAX by product-form.js, so native `required` is not enforced;
  track-day-booking-form.js validates before submit and locks "Buy it now"
  until all fields are valid.

  Usage:
  {% render 'track-day-booking-form', product: product %}
{% endcomment %}

{%- if product.handle == 'track-day-event-ticket' -%}
  <div
    class="track-day-booking-form"
    data-track-day-form
    data-summary-message="Please complete all booking details before continuing."
  >
    <h3 class="track-day-booking-form__heading">Track Day Booking Details</h3>

    <div class="track-day-booking-form__field">
      <div class="field">
        <input
          class="track-day-booking-form__input field__input"
          type="text"
          id="TrackDayName-{{ section.id }}"
          name="properties[Name]"
          placeholder="Full Name"
          autocomplete="name"
          maxlength="100"
          required
          aria-required="true"
          aria-describedby="TrackDayName-{{ section.id }}-error"
          data-track-day-field
          data-required-message="Please enter your full name."
        >
        <label class="field__label" for="TrackDayName-{{ section.id }}">Full Name</label>
      </div>
      <p class="track-day-booking-form__error form__message" id="TrackDayName-{{ section.id }}-error" hidden>
        <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
        <span class="track-day-booking-form__error-text"></span>
      </p>
    </div>

    <div class="track-day-booking-form__field">
      {%- comment -%}
        Any country: digits with an optional leading "+", up to 15 digits
        (the E.164 maximum), e.g. +6581234567 or 81234567.
        track-day-booking-form.js blocks anything else as it is typed (letters,
        spaces, symbols, a "+" anywhere but first, a 16th digit) and strips it
        from pasted numbers such as "+65 8123-4567".
      {%- endcomment -%}
      <div class="field">
        <input
          class="track-day-booking-form__input field__input"
          type="tel"
          id="TrackDayContactNumber-{{ section.id }}"
          name="properties[Contact Number]"
          placeholder="e.g. +6581234567"
          inputmode="tel"
          autocomplete="tel"
          pattern="\+?[0-9]{1,15}"
          maxlength="16"
          required
          aria-required="true"
          aria-describedby="TrackDayContactNumber-{{ section.id }}-error"
          data-track-day-field
          data-phone-max-digits="15"
          data-required-message="Please enter your contact number."
          data-invalid-message="Contact number can only contain digits (up to 15) and an optional leading + sign."
        >
        <label class="field__label" for="TrackDayContactNumber-{{ section.id }}">Contact Number</label>
      </div>
      <p class="track-day-booking-form__error form__message" id="TrackDayContactNumber-{{ section.id }}-error" hidden>
        <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
        <span class="track-day-booking-form__error-text"></span>
      </p>
    </div>

    <div class="track-day-booking-form__row">
      <div class="track-day-booking-form__field">
        <div class="field">
          <input
            class="track-day-booking-form__input field__input"
            type="date"
            id="TrackDayPreferredDate-{{ section.id }}"
            min="{{ 'now' | date: '%Y-%m-%d' }}"
            max="{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' }}"
            required
            aria-required="true"
            aria-describedby="TrackDayPreferredDate-{{ section.id }}-error"
            data-track-day-field
            data-max-days-ahead="365"
            data-required-message="Please choose a preferred date."
            data-invalid-message="Please enter a complete, valid date."
            data-underflow-message="Please choose today or a later date."
            data-overflow-message="Bookings can only be made up to 1 year in advance."
          >
          {%- comment -%}
            The visible field stays type="date" for a native picker and to block
            past/invalid dates; it has no `name` so it isn't submitted directly.
            This hidden field mirrors it in dd/mm/yyyy for the cart line item
            property, since a date input's own value is always yyyy-mm-dd.
          {%- endcomment -%}
          <input type="hidden" name="properties[Preferred Date]" data-track-day-date-hidden>
          <label class="field__label" for="TrackDayPreferredDate-{{ section.id }}">Preferred Date</label>
        </div>
        <p class="track-day-booking-form__error form__message" id="TrackDayPreferredDate-{{ section.id }}-error" hidden>
          <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
          <span class="track-day-booking-form__error-text"></span>
        </p>
      </div>

      <div class="track-day-booking-form__field">
        <div class="field">
          <input
            class="track-day-booking-form__input field__input"
            type="time"
            id="TrackDayPreferredTime-{{ section.id }}"
            name="properties[Preferred Time]"
            required
            aria-required="true"
            aria-describedby="TrackDayPreferredTime-{{ section.id }}-error"
            data-track-day-field
            data-required-message="Please choose a preferred time."
          >
          <label class="field__label" for="TrackDayPreferredTime-{{ section.id }}">Preferred Time</label>
        </div>
        <p class="track-day-booking-form__error form__message" id="TrackDayPreferredTime-{{ section.id }}-error" hidden>
          <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
          <span class="track-day-booking-form__error-text"></span>
        </p>
      </div>
    </div>

    <div class="track-day-booking-form__field">
      <div class="field">
        <input
          class="track-day-booking-form__input field__input"
          type="text"
          id="TrackDayCarPlateNumber-{{ section.id }}"
          name="properties[Car Plate Number]"
          placeholder="Car Plate Number"
          autocapitalize="characters"
          pattern="[A-Za-z0-9 ]+"
          maxlength="15"
          required
          aria-required="true"
          aria-describedby="TrackDayCarPlateNumber-{{ section.id }}-error"
          data-track-day-field
          data-required-message="Please enter your car plate number."
          data-invalid-message="Car plate number can only contain letters, numbers and spaces."
        >
        <label class="field__label" for="TrackDayCarPlateNumber-{{ section.id }}">Car Plate Number</label>
      </div>
      <p class="track-day-booking-form__error form__message" id="TrackDayCarPlateNumber-{{ section.id }}-error" hidden>
        <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
        <span class="track-day-booking-form__error-text"></span>
      </p>
    </div>
  </div>

  <script src="{{ 'track-day-booking-form.js' | asset_url }}" defer="defer"></script>

  {% style %}
    .track-day-booking-form {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      width: 100%;
      margin-bottom: 2rem;
    }

    .track-day-booking-form__heading {
      margin: 0 0 0.5rem;
      font-size: 1.6rem;
    }

    .track-day-booking-form__row {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .track-day-booking-form__row .track-day-booking-form__field {
      flex: 1 1 200px;
    }

    .track-day-booking-form__field {
      width: 100%;
    }

    .track-day-booking-form__field .field {
      margin: 0;
    }

    .track-day-booking-form__input {
      width: 100%;
    }

    /* Dawn hides placeholders behind the floating label; show the phone
       format example once the label has moved up on focus. */
    .track-day-booking-form__input[data-phone-max-digits]:focus::placeholder {
      opacity: 0.55;
    }

    .track-day-booking-form__input[aria-invalid='true'] {
      box-shadow: 0 0 0 0.1rem rgb(var(--color-foreground));
      outline: 0.1rem solid rgb(var(--color-foreground));
    }

    .track-day-booking-form__error {
      margin-top: 0.6rem;
      line-height: 1.3;
    }

    .track-day-booking-form__error[hidden] {
      display: none;
    }

    .track-day-booking-form__error .svg-wrapper {
      flex-shrink: 0;
      width: 1.3rem;
      height: 1.3rem;
      margin-right: 0.5rem;
    }

    @media screen and (max-width: 749px) {
      .track-day-booking-form__row {
        flex-direction: column;
      }
    }
  {% endstyle %}
{%- endif -%}
