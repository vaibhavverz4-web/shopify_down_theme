{%- comment -%}
  Value Proposition – What Makes Us Unique — new custom section
  Path: sections/value-proposition.liquid

  Header (eyebrow + heading + description) followed by a large centered
  image with two content blocks stacked on the left and two on the right.
  On desktop the image spans the full height of both block rows; on mobile
  everything stacks vertically with the image between the two block pairs.
  Static CSS lives in assets/value-proposition.css (class prefix: value-proposition__).

  This section is new and independent — it does not modify or depend on
  sections/product-tabs.liquid, sections/main-product.liquid (Product Feature),
  or sections/product-content.liquid.
{%- endcomment -%}

{{ 'value-proposition.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign image_alt = s.image_alt | default: s.main_image.alt | default: s.heading | strip
-%}

{%- style -%}
  #ValueProposition-{{ uid }} {
    --vp-bg: {{ s.background_color }};
    --vp-accent: {{ s.accent_color }};
    --vp-description-size: {{ s.description_size }}px;
    --vp-image-width: {{ s.image_width }}px;
    padding-top: {{ s.padding_top }}px;
    padding-bottom: {{ s.padding_bottom }}px;
  }
{%- endstyle -%}

<div id="ValueProposition-{{ uid }}" class="value-proposition">
  <div class="value-proposition__inner page-width">

    {%- if s.eyebrow != blank or s.heading != blank or s.description != blank -%}
      <div class="value-proposition__header">
        <div class="value-proposition__header-text">
          {%- if s.eyebrow != blank -%}
            <p class="value-proposition__eyebrow">{{ s.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <h2 class="value-proposition__heading {{ s.heading_size }}">{{ s.heading | escape }}</h2>
          {%- endif -%}
        </div>
        {%- if s.description != blank -%}
          <div class="value-proposition__description rte">{{ s.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="value-proposition__grid">
      {%- for i in (1..2) -%}
        {%- assign icon_key = 'block_' | append: i | append: '_icon' -%}
        {%- assign heading_key = 'block_' | append: i | append: '_heading' -%}
        {%- assign description_key = 'block_' | append: i | append: '_description' -%}
        {%- assign block_icon = s[icon_key] -%}
        {%- assign block_heading = s[heading_key] -%}
        {%- assign block_description = s[description_key] -%}
        <div class="value-proposition__block value-proposition__block--{{ i }}">
          {%- if block_icon != blank -%}
            <div class="value-proposition__icon">
              {{ block_icon | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 64, 96', alt: block_heading }}
            </div>
          {%- endif -%}
          {%- if block_heading != blank -%}
            <h3 class="value-proposition__block-heading">{{ block_heading | escape }}</h3>
          {%- endif -%}
          {%- if block_description != blank -%}
            <p class="value-proposition__block-description">{{ block_description }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}

      <div class="value-proposition__image">
        {%- if s.main_image != blank -%}
          {{
            s.main_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '300, 450, 600, 800, 1200',
              alt: image_alt
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg value-proposition__image-placeholder' }}
        {%- endif -%}
      </div>

      {%- for i in (3..4) -%}
        {%- assign icon_key = 'block_' | append: i | append: '_icon' -%}
        {%- assign heading_key = 'block_' | append: i | append: '_heading' -%}
        {%- assign description_key = 'block_' | append: i | append: '_description' -%}
        {%- assign block_icon = s[icon_key] -%}
        {%- assign block_heading = s[heading_key] -%}
        {%- assign block_description = s[description_key] -%}
        <div class="value-proposition__block value-proposition__block--{{ i }}">
          {%- if block_icon != blank -%}
            <div class="value-proposition__icon">
              {{ block_icon | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 64, 96', alt: block_heading }}
            </div>
          {%- endif -%}
          {%- if block_heading != blank -%}
            <h3 class="value-proposition__block-heading">{{ block_heading | escape }}</h3>
          {%- endif -%}
          {%- if block_description != blank -%}
            <p class="value-proposition__block-description">{{ block_description }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Value Proposition",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Value Proposition" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Makes Us Unique" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Share what sets your brand apart — quality, service, and the details that keep customers coming back.</p>"
    },

    { "type": "header", "content": "Main image" },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Center image",
      "info": "Supports PNG, JPG/JPEG, and WebP, including transparent PNGs."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Optional. Defaults to the image's own alt text, then the heading."
    },
    { "type": "range", "id": "image_width", "min": 200, "max": 600, "step": 10, "unit": "px", "label": "Image width", "default": 380 },

    { "type": "header", "content": "Block 1" },
    { "type": "image_picker", "id": "block_1_icon", "label": "Icon" },
    { "type": "text", "id": "block_1_heading", "label": "Heading", "default": "Premium Quality" },
    {
      "type": "textarea",
      "id": "block_1_description",
      "label": "Description",
      "default": "Every product is crafted with care and tested for lasting quality."
    },

    { "type": "header", "content": "Block 2" },
    { "type": "image_picker", "id": "block_2_icon", "label": "Icon" },
    { "type": "text", "id": "block_2_heading", "label": "Heading", "default": "Fast Shipping" },
    {
      "type": "textarea",
      "id": "block_2_description",
      "label": "Description",
      "default": "Quick, reliable delivery so you get what you need, when you need it."
    },

    { "type": "header", "content": "Block 3" },
    { "type": "image_picker", "id": "block_3_icon", "label": "Icon" },
    { "type": "text", "id": "block_3_heading", "label": "Heading", "default": "Trusted by Thousands" },
    {
      "type": "textarea",
      "id": "block_3_description",
      "label": "Description",
      "default": "Loved by a growing community of happy, repeat customers."
    },

    { "type": "header", "content": "Block 4" },
    { "type": "image_picker", "id": "block_4_icon", "label": "Icon" },
    { "type": "text", "id": "block_4_heading", "label": "Heading", "default": "Dedicated Support" },
    {
      "type": "textarea",
      "id": "block_4_description",
      "label": "Description",
      "default": "Our team is here to help before and after every purchase."
    },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Icon / accent color", "default": "#2f6b4f" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h1"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 16
    },

    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "presets": [
    { "name": "Value Proposition" }
  ]
}
{% endschema %}
