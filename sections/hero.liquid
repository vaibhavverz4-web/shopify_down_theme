

<div class="hero" style="background-color: {{ section.settings.bg_color }};">

  {% if section.settings.bg_image %}
    {{ section.settings.bg_image | image_url: width: 2000 | image_tag: class: 'hero__bg', loading: 'lazy' }}
  {% endif %}

  <div class="hero__content">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>

    {% if section.settings.btn_text != blank %}
      <a href="{{ section.settings.btn_link }}" class="btn">
        {{ section.settings.btn_text }}
      </a>
    {% endif %}
  </div>
  
</div>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#f4f4f4" },
    { "type": "text", "id": "btn_text", "label": "Button text", "default": "Shop now" },
    { "type": "url", "id": "btn_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}

