{%- comment -%}
  Custom Banner — new custom section
  Path: sections/custom-banner.liquid

  Full-width image banner with separate desktop/mobile images, an editable
  heading, description and button. Static CSS lives in assets/section-custom-banner.css
  (class prefix: custom-banner__).
{%- endcomment -%}

{{ 'section-custom-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign overlay_alpha = s.overlay_opacity | divided_by: 100.0
  assign fallback_image = s.image | default: s.image_mobile
-%}

{%- style -%}
  #CustomBanner-{{ uid }} {
    --custom-banner-height: {{ s.height_mobile }}px;
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #CustomBanner-{{ uid }} .custom-banner__overlay {
    opacity: {{ overlay_alpha }};
  }

  @media screen and (min-width: 750px) {
    #CustomBanner-{{ uid }} {
      --custom-banner-height: {{ s.height }}px;
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="CustomBanner-{{ uid }}"
  class="custom-banner color-{{ s.color_scheme }} gradient custom-banner--align-{{ s.text_alignment }}"
>
  <div class="custom-banner__media">
    {%- if fallback_image != blank -%}
      <picture>
        {%- if s.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {%- if s.image_mobile.width >= 375 -%}{{ s.image_mobile | image_url: width: 375 }} 375w,{%- endif -%}
              {%- if s.image_mobile.width >= 550 -%}{{ s.image_mobile | image_url: width: 550 }} 550w,{%- endif -%}
              {%- if s.image_mobile.width >= 750 -%}{{ s.image_mobile | image_url: width: 750 }} 750w,{%- endif -%}
              {{ s.image_mobile | image_url }} {{ s.image_mobile.width }}w
            "
          >
        {%- endif -%}
        <img
          src="{{ fallback_image | image_url: width: 1500 }}"
          srcset="
            {%- if fallback_image.width >= 750 -%}{{ fallback_image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if fallback_image.width >= 1100 -%}{{ fallback_image | image_url: width: 1100 }} 1100w,{%- endif -%}
            {%- if fallback_image.width >= 1500 -%}{{ fallback_image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {%- if fallback_image.width >= 1780 -%}{{ fallback_image | image_url: width: 1780 }} 1780w,{%- endif -%}
            {%- if fallback_image.width >= 2000 -%}{{ fallback_image | image_url: width: 2000 }} 2000w,{%- endif -%}
            {{ fallback_image | image_url }} {{ fallback_image.width }}w
          "
          sizes="100vw"
          width="{{ fallback_image.width }}"
          height="{{ fallback_image.height }}"
          alt="{{ fallback_image.alt | default: s.heading | escape }}"
          class="custom-banner__image"
          loading="lazy"
        >
      </picture>
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg custom-banner__placeholder' }}
    {%- endif -%}
    <div class="custom-banner__overlay" aria-hidden="true"></div>
  </div>

  <div class="custom-banner__inner page-width">
    <div class="custom-banner__content">
      {%- if s.heading != blank -%}
        <h2 class="custom-banner__heading {{ s.heading_size }}">{{ s.heading | escape }}</h2>
      {%- endif -%}

      {%- if s.description != blank -%}
        <div class="custom-banner__description rte">{{ s.description }}</div>
      {%- endif -%}

      {%- if s.button_label != blank -%}
        <a
          {% if s.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ s.button_link }}"
          {% endif %}
          class="custom-banner__button button button--primary"
        >
          {{- s.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image",
      "info": "Used on tablet and desktop. Also used on mobile if no mobile image is set."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Shown only below 750px wide. Falls back to the desktop image if left blank."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "info": "Darkens the image so the text stays readable.",
      "default": 20
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Introducing our new banner"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Share details about this banner, a product, or a promotion with your customers.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "height",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Section height",
      "default": 550
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 250,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Section height, mobile",
      "default": 420
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
