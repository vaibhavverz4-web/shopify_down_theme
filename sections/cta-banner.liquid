{%- comment -%}
  CTA Banner — new custom section
  Path: sections/cta-banner.liquid

  Full-width photo hero with a dark overlay and centered CTA content.
  Static CSS lives in assets/custom.css (class prefix: cta-banner__).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign overlay_alpha = s.overlay_opacity | divided_by: 100.0
-%}

{%- style -%}
  #CtaBanner-{{ uid }} {
    --cta-banner-height: {{ s.height_mobile }}px;
    --cta-banner-overlay-top: rgba(0, 0, 0, {{ overlay_alpha | times: 0.6 }});
    --cta-banner-overlay-bottom: rgba(0, 0, 0, {{ overlay_alpha }});
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #CtaBanner-{{ uid }} {
      --cta-banner-height: {{ s.height }}px;
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="CtaBanner-{{ uid }}"
  class="cta-banner color-{{ s.color_scheme }} gradient cta-banner--align-{{ s.text_alignment }}"
>
  {%- liquid
    assign fallback_image = s.image | default: s.image_mobile
  -%}
  <div class="cta-banner__media">
    {%- if fallback_image != blank -%}
      <picture>
        {%- if s.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {%- if s.image_mobile.width >= 375 -%}{{ s.image_mobile | image_url: width: 375 }} 375w,{%- endif -%}
              {%- if s.image_mobile.width >= 550 -%}{{ s.image_mobile | image_url: width: 550 }} 550w,{%- endif -%}
              {%- if s.image_mobile.width >= 750 -%}{{ s.image_mobile | image_url: width: 750 }} 750w,{%- endif -%}
              {{ s.image_mobile | image_url }} {{ s.image_mobile.width }}w
            "
          >
        {%- endif -%}
        <img
          src="{{ fallback_image | image_url: width: 1500 }}"
          srcset="
            {%- if fallback_image.width >= 750 -%}{{ fallback_image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if fallback_image.width >= 1100 -%}{{ fallback_image | image_url: width: 1100 }} 1100w,{%- endif -%}
            {%- if fallback_image.width >= 1500 -%}{{ fallback_image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {%- if fallback_image.width >= 1780 -%}{{ fallback_image | image_url: width: 1780 }} 1780w,{%- endif -%}
            {%- if fallback_image.width >= 2000 -%}{{ fallback_image | image_url: width: 2000 }} 2000w,{%- endif -%}
            {{ fallback_image | image_url }} {{ fallback_image.width }}w
          "
          sizes="100vw"
          width="{{ fallback_image.width }}"
          height="{{ fallback_image.height }}"
          alt="{{ fallback_image.alt | escape }}"
          class="cta-banner__image"
          style="object-position: {{ s.focal_point | replace: '-', ' ' }};"
          fetchpriority="high"
        >
      </picture>
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg cta-banner__image' }}
    {%- endif -%}
    <div class="cta-banner__overlay" aria-hidden="true"></div>
  </div>

  <div class="cta-banner__inner page-width">
    <div class="cta-banner__content">
      {%- if s.top_text != blank -%}
        <p class="cta-banner__eyebrow">{{ s.top_text | escape }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="cta-banner__heading">{{ s.heading | escape }}</h2>
      {%- endif -%}

      {%- if s.description != blank -%}
        <div class="cta-banner__description rte">{{ s.description }}</div>
      {%- endif -%}

      {%- if s.button_label != blank -%}
        <a
          {% if s.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ s.button_link }}"
          {% endif %}
          class="cta-banner__button"
        >
          <span>{{ s.button_label | escape }}</span>
          <svg class="cta-banner__button-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path
              d="M1 8h13M9 3l5 5-5 5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CTA Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image",
      "info": "Used on desktop and tablet. Also used on mobile if no mobile image is set."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Shown only below 750px wide. Falls back to the desktop image if left blank."
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "Image position",
      "info": "Which part of the photo stays in frame on narrow screens.",
      "options": [
        { "value": "left-top", "label": "Top left" },
        { "value": "center-top", "label": "Top center" },
        { "value": "right-top", "label": "Top right" },
        { "value": "left-center", "label": "Middle left" },
        { "value": "center-center", "label": "Middle center" },
        { "value": "right-center", "label": "Middle right" },
        { "value": "left-bottom", "label": "Bottom left" },
        { "value": "center-bottom", "label": "Bottom center" },
        { "value": "right-bottom", "label": "Bottom right" }
      ],
      "default": "center-center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "info": "Darkens the image so the white text stays readable.",
      "default": 50
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "top_text",
      "label": "Small text",
      "default": "Perfect For You"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Our Journey"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Explore our range of health supplements, organic essentials, skincare, and wellness products designed to support your everyday well-being.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Shop Products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "height",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Section height",
      "default": 550
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 250,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Section height, mobile",
      "default": 420
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "CTA Banner"
    }
  ]
}
{% endschema %}
